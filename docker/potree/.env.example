# Copy to docker/potree/.env (git-ignored) and edit.

# The site root: the folder holding index.html, build/, libs/, pointclouds*/, data/.
# Left empty on purpose: compose refuses to start until you set it.
#
# !! Do NOT point it at /Volumes/2TB/... on the Mac: Docker Desktop cannot bind-mount
#    that exFAT volume -- the container hangs in `Created` and wedges the daemon until
#    Docker Desktop is force-quit. rsync the site onto the internal APFS disk first, e.g.
#    POTREE_SITE=/Users/christian/potree/berlin_potree_v2
# carrot (Linux, native mounts; copy with rsync --chmod=Da+rx,Fa+r so nginx can read it):
#    POTREE_SITE=/raid/cwinkelmann/potree/berlin_potree_v2
POTREE_SITE=

# Host port the viewer is published on.
POTREE_PORT=8080

# 127.0.0.1 = this machine only. Use 0.0.0.0 on carrot to reach it over the VPN.
POTREE_BIND=127.0.0.1
